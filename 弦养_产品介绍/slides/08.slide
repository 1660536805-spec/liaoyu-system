<Slide style={{ width: 1280, height: 720, background: '#FBF3E3', padding: '20px 72px', flexDirection: 'column' }}>
    <Box style={{ height: 78, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
        <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 15, letterSpacing: 3, color: '#B0552E', fontFamily: '"PingFang SC", sans-serif' }}>架 构 与 模 块 边 界</Text>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#241C14', fontFamily: '"Songti SC","STSong",serif' }}>一条可替换的链路</Text>
        </Box>
        <Box style={{ width: 44, height: 44, borderRadius: 4, background: 'linear-gradient(135deg,#C2543C 0%,#8F3F1F 100%)', justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 20, color: '#FBEFD8', fontFamily: '"Songti SC",serif', fontWeight: 'bold' }}>弦</Text>
        </Box>
    </Box>
    <Box style={{ height: 1, background: '#E3D6BC', marginTop: 6 }} />
    <Box style={{ flexDirection: 'row', gap: 34, marginTop: 20, height: 542 }}>
        <Box style={{ width: 736, flexDirection: 'column' }}>
            <Text style={{ fontSize: 15, letterSpacing: 2, color: '#6E8F7C', fontFamily: '"PingFang SC", sans-serif', marginBottom: 14 }}>现 有 原 型 链 路</Text>
            {[
                { n: '1', t: '摄像头画面', d: '浏览器采集接入姿态链路', c: '#6E8F7C' },
                { n: '2', t: 'Pose Landmarker 关键点', d: '本地姿态模型输出统一关键点帧', c: '#6E8F7C' },
                { n: '3', t: '八段锦动作判定', d: '输出命中、周期、完成等事件', c: '#B08A3E' },
                { n: '4', t: '弦音与弦位反馈', d: '一至七弦触发琴音，弦位亮起', c: '#B0552E' },
                { n: '5', t: '本地练习记录', d: '完成提示与结果归档', c: '#8C8474' },
            ].map((s, i) => (
                <Box key={i} style={{ flexDirection: 'row', gap: 18 }}>
                    <Box style={{ width: 44, flexDirection: 'column', alignItems: 'center' }}>
                        <Box style={{ width: 40, height: 40, borderRadius: 20, background: s.c, justifyContent: 'center', alignItems: 'center', boxShadow: '0 6px 16px rgba(60,40,20,0.16)' }}>
                            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FBF3E3', fontFamily: '"Songti SC",serif' }}>{s.n}</Text>
                        </Box>
                        {i < 4 ? <Box style={{ width: 2, flex: 1, background: '#DCCBA8' }} /> : <Box style={{ height: 4 }} />}
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: 4, paddingBottom: 19 }}>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#241C14', fontFamily: '"PingFang SC", sans-serif' }}>{s.t}</Text>
                        <Text style={{ fontSize: 16, color: '#7C6B54', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.6 }}>{s.d}</Text>
                    </Box>
                </Box>
            ))}
            <Box style={{ marginTop: 4, background: '#F2E7D2', borderRadius: 8, padding: '14px 20px', borderLeft: '3px solid #C9A97E' }}>
                <Text style={{ fontSize: 16, color: '#5C4E3C', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.6 }}>
                    逻辑接线：姿态输入 → 动作判定 → 动作事件 → 音频、界面与记录；文化编排向练习与音频下发配置，而不是把每个动作绑定成脏器结论。
                </Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
            <Text style={{ fontSize: 15, letterSpacing: 2, color: '#B0552E', fontFamily: '"PingFang SC", sans-serif' }}>接 口 契 约 · 设 计 中</Text>
            <Box style={{ background: '#1E1710', borderRadius: 8, padding: 20, flexDirection: 'column', gap: 14 }}>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 17, color: '#E9B85F', fontFamily: '"SF Mono","Menlo",monospace' }}>onHit(stringIndex)</Text>
                    <Text style={{ fontSize: 15, color: '#A2937A', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.5 }}>1–7 弦触发对应琴弦；完成齐鸣使用 choir。</Text>
                </Box>
                <Box style={{ height: 1, background: 'rgba(201,169,126,0.22)' }} />
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 17, color: '#E9B85F', fontFamily: '"SF Mono","Menlo",monospace' }}>onPulse()</Text>
                    <Text style={{ fontSize: 15, color: '#A2937A', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.5 }}>一次完整动作周期，用于推进音乐乐句。</Text>
                </Box>
                <Box style={{ height: 1, background: 'rgba(201,169,126,0.22)' }} />
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 17, color: '#E9B85F', fontFamily: '"SF Mono","Menlo",monospace' }}>onFinish()</Text>
                    <Text style={{ fontSize: 15, color: '#A2937A', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.5 }}>本次练习结束，触发音乐收束与结果归档。</Text>
                </Box>
            </Box>
            <Box style={{ flex: 1, justifyContent: 'center', background: '#F2E7D2', borderRadius: 8, padding: 20, borderLeft: '3px solid #6E8F7C' }}>
                <Text style={{ fontSize: 16, color: '#4E5B4F', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.68 }}>
                    这是设计契约，不是可直接安装调用的已发布 SDK——不公开判定阈值与音色实现。
                </Text>
                <Text style={{ fontSize: 15, color: '#8A7A5E', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.6, marginTop: 10 }}>
                    模块：文化与体验编排 / 姿态输入适配 / 动作判定 / 音频模块 / 场景与记录。
                </Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 30, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 14, color: '#A9977B', fontFamily: '"PingFang SC", sans-serif' }}>弦养 · 以身为琴，以动为弦</Text>
        <Text style={{ fontSize: 14, color: '#A9977B', fontFamily: '"PingFang SC", sans-serif' }}>08 / 12</Text>
    </Box>
</Slide>
