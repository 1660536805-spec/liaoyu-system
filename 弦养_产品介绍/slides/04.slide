<Slide style={{ width: 1280, height: 720, background: '#FBF3E3', padding: '20px 72px', flexDirection: 'column' }}>
    <Box style={{ height: 78, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
        <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 15, letterSpacing: 3, color: '#B0552E', fontFamily: '"PingFang SC", sans-serif' }}>文 化 内 核 · 数 字 化</Text>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#241C14', fontFamily: '"Songti SC","STSong",serif' }}>让文化进入可配置内容与可执行声音</Text>
        </Box>
        <Box style={{ width: 44, height: 44, borderRadius: 4, background: 'linear-gradient(135deg,#C2543C 0%,#8F3F1F 100%)', justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 20, color: '#FBEFD8', fontFamily: '"Songti SC",serif', fontWeight: 'bold' }}>弦</Text>
        </Box>
    </Box>
    <Box style={{ height: 1, background: '#E3D6BC', marginTop: 6 }} />
    <Box style={{ flexDirection: 'row', gap: 26, marginTop: 18, height: 540 }}>
        <Box style={{ width: 764, flexDirection: 'column', gap: 14 }}>
            <Box style={{ background: '#F2E7D2', borderRadius: 8, padding: '13px 20px', borderLeft: '3px solid #B0552E' }}>
                <Text style={{ fontSize: 17, color: '#5C4E3C', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.5 }}>
                    数字化不只是把传统概念写进界面，而是让它进入<span style={{ color: '#B0552E', fontWeight: 'bold' }}>可配置内容</span>与<span style={{ color: '#B0552E', fontWeight: 'bold' }}>可执行声音</span>——每条线索都有对应字段、参数与来源。
                </Text>
            </Box>
            <Box style={{ flexDirection: 'column', border: '1px solid #E3D6BC', borderRadius: 8, overflow: 'hidden' }}>
                <Box style={{ flexDirection: 'row', background: '#B0552E', height: 44 }}>
                    <Box style={{ width: 154, paddingLeft: 16, justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FBEFD8', fontFamily: '"PingFang SC", sans-serif' }}>文化内容元素</Text>
                    </Box>
                    <Box style={{ width: 322, paddingLeft: 16, justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FBEFD8', fontFamily: '"PingFang SC", sans-serif' }}>数字化表达</Text>
                    </Box>
                    <Box style={{ flex: 1, paddingLeft: 16, justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FBEFD8', fontFamily: '"PingFang SC", sans-serif' }}>在体验中的作用</Text>
                    </Box>
                </Box>
                {[
                    { k: '五音', e: '五音名称、产品定弦、基调与乐句参数', r: '生成或组织不同声音氛围' },
                    { k: '五脏关联', e: '五脏、五行、五音、动作意象的关系表', r: '组织入口与推荐解释，不做诊断' },
                    { k: '八段锦', e: '动作编号、次序、示范关键点与判定输出', r: '把身体动作转成可响应事件' },
                    { k: '古琴声音', e: '合成声音参数、录音文件、来源与许可', r: '区分交互合成音与真人演奏' },
                    { k: '阶段体验', e: '阶段编号、点 / 线 / 面形态、触发与收束策略', r: '从单声回应进入连续体验' },
                ].map((r, i) => (
                    <Box key={i} style={{ flexDirection: 'row', height: 73, borderTop: '1px solid #E3D6BC', background: i % 2 === 0 ? '#FFFFFF' : '#FAF4E6' }}>
                        <Box style={{ width: 154, paddingLeft: 16, paddingRight: 10, justifyContent: 'center' }}>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#B0552E', fontFamily: '"Songti SC",serif' }}>{r.k}</Text>
                        </Box>
                        <Box style={{ width: 322, paddingLeft: 16, paddingRight: 12, justifyContent: 'center' }}>
                            <Text style={{ fontSize: 15, color: '#4A3E2E', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.5 }}>{r.e}</Text>
                        </Box>
                        <Box style={{ flex: 1, paddingLeft: 16, paddingRight: 12, justifyContent: 'center' }}>
                            <Text style={{ fontSize: 15, color: '#5C4E3C', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.5 }}>{r.r}</Text>
                        </Box>
                    </Box>
                ))}
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 15, letterSpacing: 2, color: '#B08A3E', fontFamily: '"PingFang SC", sans-serif' }}>文 化 配 置 模 型 · 示 例</Text>
            <Box style={{ background: '#1E1710', borderRadius: 8, padding: '14px 16px' }}>
                <Text style={{ fontSize: 12.5, color: '#8A7A5E', fontFamily: '"SF Mono","Menlo",monospace', lineHeight: 1.65 }}>{'{'}</Text>
                <Text style={{ fontSize: 12.5, color: '#C9A97E', fontFamily: '"SF Mono","Menlo",monospace', lineHeight: 1.65 }}>{'  "profileId": "lung-calm-home",'}</Text>
                <Text style={{ fontSize: 12.5, color: '#E9B85F', fontFamily: '"SF Mono","Menlo",monospace', lineHeight: 1.65 }}>{'  "tone": "商",'}</Text>
                <Text style={{ fontSize: 12.5, color: '#C9A97E', fontFamily: '"SF Mono","Menlo",monospace', lineHeight: 1.65 }}>{'  "mood": "收敛、安静",'}</Text>
                <Text style={{ fontSize: 12.5, color: '#C9A97E', fontFamily: '"SF Mono","Menlo",monospace', lineHeight: 1.65 }}>{'  "audioProfileId": "shang-home",'}</Text>
                <Text style={{ fontSize: 12.5, color: '#FBF3E3', fontFamily: '"SF Mono","Menlo",monospace', lineHeight: 1.65 }}>{'  "disclaimer": "文化编排，不构成医疗建议"'}</Text>
                <Text style={{ fontSize: 12.5, color: '#8A7A5E', fontFamily: '"SF Mono","Menlo",monospace', lineHeight: 1.65 }}>{'}'}</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 8, background: '#F2E7D2', borderRadius: 8, padding: 18, borderLeft: '3px solid #6E8F7C' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#4E5B4F', fontFamily: '"PingFang SC", sans-serif' }}>可配置，而非硬编码</Text>
                <Text style={{ fontSize: 15, color: '#4E5B4F', fontFamily: '"PingFang SC", sans-serif', lineHeight: 1.6 }}>
                    文化关联从页面与代码中独立成配置记录（五音 / 五脏标签、编排理由、练习内容、阶段、音频标识、来源与授权），避免硬编码进动作识别器。
                </Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 30, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 14, color: '#A9977B', fontFamily: '"PingFang SC", sans-serif' }}>弦养 · 以身为琴，以动为弦</Text>
        <Text style={{ fontSize: 14, color: '#A9977B', fontFamily: '"PingFang SC", sans-serif' }}>04 / 12</Text>
    </Box>
</Slide>
