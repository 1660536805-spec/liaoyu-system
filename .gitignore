.workbuddy/
.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example
node_modules/
__pycache__/
*.pyc
# ---- outputs/ 工作产物：截图与交付包，可用脚本重跑再生成，不进版本库 ----
# 保留跟踪：outputs/*.md（产品文档/PPT 大纲）、outputs/ui-compare/*.cjs（比对脚本）
outputs/**/*.png
outputs/**/*.zip
outputs/bugfix-results.txt
outputs/verify/
outputs/s4-integration/
outputs/复刻截图/
outputs/复刻截图v2/
outputs/ui-compare/out/
outputs/ui-compare/evidence/
# 例外：AIC 报告渲染管线的标志素材——render.cjs / gen_docx.py 运行时读取该 PNG 生成
# base64 页眉标志，是可重跑的「源码依赖」而非可丢的截图，故放行（其余 outputs/*.png 仍忽略）。
!outputs/aic-report/assets/*.png

# ---- dist 内「运行时不读」的副本与废弃原型 ----
# s4 构建(vite --outDir=../dist/s4)会把 train/public/* 复制到 dist/s4/，
# 但应用一律请求根路径(/wasm、/models、/photos)，故 /s4/ 下的副本无人引用、不入库。
dist/s4/wasm/
dist/s4/models/
dist/s4/photos/
# dist/s4/art/ 与根目录 dist/art/ 逐字节相同（12 文件 2.6M）；主壳/子应用请求的都是根路径 /art/。
dist/s4/art/
dist/s4/xianyang-ca.crt
dist/s4/setup-cert.html
dist/s4/stability.html
dist/s4/fov-probe.html
# 老版原型，已被 app.js / app.css 取代，全仓零引用
dist/shell.js
dist/shell.css
dist/flow.js
dist/flow.css

# ---- 文档生成流水线的工作目录（tencent-docx 残留）----
output/

# ---- 大体积工作产物（不入库：合计 >50MB，含 110MB 演示视频 / 姿态抽帧）----
outputs/video/
outputs/truth-pack/
outputs/activate-all/out/

# ---- 弦养_产品介绍/：只入库「幻灯片源 + 成品 + 素材」，渲染产物与缓存不入库 ----
# preview/    = 12 张页面渲染预览（6.6M，凭 slides/*.slide 可重新渲染）
# .cache/     = slidep 工具缓存（8.1M）
# .slidep/    = slidep 命令记录与日志（62K，工具状态，非内容）
# *.bak.pptx  = 成品备份（8.1M，与正式成品仅差十几 KB）
弦养_产品介绍/preview/
弦养_产品介绍/.cache/
弦养_产品介绍/.slidep/
弦养_产品介绍/*.bak.pptx
